<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.MainPage">

    <Grid>
        <!-- Background gradient, Apple Weather-style sky blue -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4A90D9" Offset="0.0" />
                <GradientStop Color="#1C3F6E" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="30,60,30,30" Spacing="8" VerticalOptions="Start">

                <!-- City name -->
                <Label x:Name="CityLabel"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- Big temperature -->
                <Label x:Name="TempLabel"
                       FontSize="96"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />

                <!-- Condition description -->
                <Label x:Name="DescriptionLabel"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- High/low style secondary row -->
                <Label x:Name="HumidityLabel"
                       FontSize="16"
                       TextColor="#D0E0F5"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0" />

                <ActivityIndicator x:Name="LoadingIndicator"
                                    IsVisible="False"
                                    IsRunning="False"
                                    Color="White"
                                    Margin="0,30,0,0" />

                <Button x:Name="GetWeatherButton"
                        Text="Refresh"
                        Clicked="OnGetWeatherClicked"
                        BackgroundColor="#2A5A9C"
                        TextColor="White"
                        CornerRadius="20"
                        Margin="0,40,0,0"
                        WidthRequest="120"
                        HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>